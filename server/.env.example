# Server Port
PORT=4000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sports_analytics?schema=public"

# JWT Authentication Config
JWT_SECRET="sports_analytics_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Redis Cache Config
REDIS_URL="redis://localhost:6379"

# External Sports API Keys (for live feeds integration)
SPORTS_API_KEY="your_api_key_here"
SPORTS_API_BASE_URL="https://api.sportsdata.io/v3"

# Node Environment
NODE_ENV="development"
